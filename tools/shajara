def main():
    p = argparse.ArgumentParser(prog="shajara", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    def cmd(name, fn, help, json_flag=False):
        q = sub.add_parser(name, help=help); q.set_defaults(fn=fn)
        if json_flag: q.add_argument("--json", action="store_true", help="raw data")
        return q
    def group(name, help):
        g = sub.add_parser(name, help=help).add_subparsers(dest="sub", required=True)
        def c(n, fn, h, json_flag=False):
            q = g.add_parser(n, help=h); q.set_defaults(fn=fn)
            if json_flag: q.add_argument("--json", action="store_true", help="raw data")
            return q
        return c

    q = cmd("login", cmd_login, "log into a space with its passcode"); q.add_argument("passcode"); q.add_argument("--as", dest="as_", help="your name in the space")
    q = cmd("use", cmd_use, "switch between spaces you're logged into"); q.add_argument("space")
    cmd("whoami", cmd_whoami, "which space, and who you are")
    cmd("people", cmd_people, "members, instruments and sounds", True)
    cmd("sets", cmd_sets, "list sets", True)
    cmd("tracks", cmd_tracks, "list tracks", True)
    cmd("guide", cmd_guide, "how Shajara's model works (read this first)")
    q = sub.add_parser("skill", help="install the Claude Code skill"); q.add_argument("action", choices=["install"]); q.set_defaults(fn=cmd_skill)

    c = group("set", "show or change a set")
    q = c("show", cmd_set_show, "everything in a set", True); q.add_argument("set")
    q = c("edit", cmd_set_edit, "name, date, venue, notes, cast"); q.add_argument("set")
    for f in ("name", "date", "venue", "notes"): q.add_argument("--" + f)
    q.add_argument("--cast", help="comma-separated names")
    q = c("move", cmd_set_move, "move a track in the running order"); q.add_argument("set"); q.add_argument("track"); q.add_argument("position", type=int)
    q = c("add-track", cmd_set_add_track, "plant a new track in the set, or bring in a version of one"); q.add_argument("set")
    for f in ("title", "sections", "maqam", "version-of"): q.add_argument("--" + f)
    q.add_argument("--tempo", type=int)
    q = c("remove-track", cmd_set_remove_track, "delete the set's version of a track"); q.add_argument("set"); q.add_argument("track"); q.add_argument("--yes", action="store_true")

    c = group("track", "show or change a track")
    q = c("show", cmd_track_show, "a track's sections and line-ups", True); q.add_argument("track")
    q = c("edit", cmd_track_edit, "title, maqam, tonic, tempo, chords, notes, genre"); q.add_argument("track")
    for f in ("title", "maqam", "tonic", "chords", "notes", "genre"): q.add_argument("--" + f)
    q.add_argument("--tempo", type=int)

    c = group("section", "show, add, change, move or delete a section")
    q = c("show", cmd_section_show, "one section", True); q.add_argument("section")
    q = c("add", cmd_section_add, "add a section"); q.add_argument("track"); q.add_argument("name"); q.add_argument("--at", type=int); q.add_argument("--copy-from")
    q = c("edit", cmd_section_edit, "change a section"); q.add_argument("section")
    for f in ("name", "notes", "chords", "meter"): q.add_argument("--" + f)
    q.add_argument("--energy", type=int, choices=range(1, 6)); q.add_argument("--bars", type=int); q.add_argument("--weight", type=float)
    q = c("move", cmd_section_move, "move a section to a position"); q.add_argument("section"); q.add_argument("position", type=int)
    q = c("delete", cmd_section_delete, "delete a section (and its recordings)"); q.add_argument("section"); q.add_argument("--yes", action="store_true")

    c = group("lineup", "who plays what in a section")
    q = c("put", cmd_lineup_put, "put someone in a layer (replaces where they were in this section)"); q.add_argument("section"); q.add_argument("member"); q.add_argument("layer")
    q.add_argument("--on", help="instrument"); q.add_argument("--part", help="what they play, in words"); q.add_argument("--sounds", help="comma-separated sound names")
    q = c("drop", cmd_lineup_drop, "take someone out of a section"); q.add_argument("section"); q.add_argument("member"); q.add_argument("--layer")
    q = c("clear", cmd_lineup_clear, "empty a section's line-up"); q.add_argument("section"); q.add_argument("--yes", action="store_true")

    q = sub.add_parser("cue", help="how the band moves into a section"); q.set_defaults(fn=cmd_cue)
    q.add_argument("action", choices=["set", "add", "clear"]); q.add_argument("section"); q.add_argument("giver", nargs="?", default=""); q.add_argument("text", nargs="?", default="")

    q = sub.add_parser("beat", help="a rhythm grid on a section's layer"); q.set_defaults(fn=cmd_beat)
    q.add_argument("action", choices=["presets", "set", "clear"]); q.add_argument("section", nargs="?"); q.add_argument("name", nargs="?")
    q.add_argument("--layer", default="substrate"); q.add_argument("--pattern", help="D dum, T tak, K ka, - rest"); q.add_argument("--sub", type=int, choices=[1, 2, 3, 4, 6, 8])

    q = sub.add_parser("task", help="small to-dos on a set"); q.set_defaults(fn=cmd_task)
    q.add_argument("action", choices=["list", "add", "done", "undo", "drop"]); q.add_argument("set"); q.add_argument("text", nargs="?", default="")
    q.add_argument("--for", dest="for_", help="who does it (default: anyone)")

    a = p.parse_args()
    if a.cmd == "beat" and a.action != "presets" and not a.section: die("Which section? Track:Section")
    if a.cmd == "cue" and a.action != "clear" and not a.giver: die("Who gives the cue? A member's name or production.")
    a.fn(a)

if __name__ == "__main__":
    main()
